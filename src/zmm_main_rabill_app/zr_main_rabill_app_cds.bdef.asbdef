managed implementation in class zbp_r_main_rabill_app_cds unique;
strict ( 2 );
with draft;
define behavior for ZR_MAIN_Rabill_APP_CDS alias ZrMmrabillPaAppr
persistent table zmm_main_ra_t
draft table zmm_rabill__ap_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )

{
  field ( mandatory : create )
   Werks,
   AppLevel;

  field ( readonly )
   LocalCreatedBy,
   LocalCreatedAt,
   LocalLastChangedBy,
   LocalLastChangedAt,
   LastChangedAt;

  field ( readonly : update )
   Werks,
   AppLevel;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for zmm_main_ra_t
  {
    Werks = werks;
    AppLevel = app_level;
    Userid = userid;
    Username = username;
    EmailId = email_id;
    LocalCreatedBy = local_created_by;
    LocalCreatedAt = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt = last_changed_at;
  }
}